---
interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
---

<article class="m-auto mb-10">
  <img
    src={src}
    alt={alt}
    class="lg:w-5/4 md:h-[400px] block aspect-square object-cover rounded-md h-[400px]"
  />
  <h3 class="text-2xl mt-3">{title}</h3>
</article>
