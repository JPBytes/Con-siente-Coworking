---
interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
---

<article class="m-auto rounded-md overflow-hidden mb-10">
  <img
    src={src}
    alt={alt}
    class="w-5/4 h-[400px] block aspect-square object-cover"
  />
  <h3 class="text-2xl mt-3">{title}</h3>
</article>
