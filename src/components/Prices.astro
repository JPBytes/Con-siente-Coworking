---
interface Props {
  title: string;
  price: string;
  adventage1: string;
  adventage2: string;
  adventage3: string;
  body: string;
}

const { title, price, adventage1, adventage2, adventage3, body } = Astro.props;
---

<article
  class="bg-gray-200 md:w-2/5 lg:w-1/5 p-5 rounded-xl border-4 border-azul-marino font-Poppins"
>
  <slot />
  <h3 class="font-bold md:text-xl lg:text-2xl">{title}</h3>
  <p class="font-bold text-xl xl:text-2xl">{price}</p>
  <p class="font-bold text-lg">por mes</p>
  <a
    href="/"
    class="bg-azul-marino text-white p-2 block my-4 text-center rounded-xl text-lg"
    >Más informacion</a
  >
  <p class="font-Lato text-lg font-semibold">{body}</p>
  <div>
    <p class="font-Lato text-lg font-medium before:content-['✔']">
      {adventage1}
    </p>
    <p class="font-Lato text-lg font-medium before:content-['✔']">
      {adventage2}
    </p>
    <p class="font-Lato text-lg font-medium before:content-['✔']">
      {adventage3}
    </p>
  </div>
</article>
