---
import Popular from "./Icons/Popular.astro";
---

<div class="flex items-center justify-center md:flex-row flex-col">
  <article
    class="lg:w-1/4 w-3/4 md:w-52 border-2 border-gris bg-gris/20 py-7 px-3 my-3"
  >
    <h3 class="font-Poppins font-semibold text-xl">
      Espacio de trabajo compartido
    </h3>
    <p class="font-Poppins font-semibold text-2xl leading-3 my-3">
      $100.000 <br />
      <span class="text-lg">por mes</span>
    </p>
    <a
      href="https://wa.me/573226530630"
      target="_blank"
      rel="noopener"
      class="font-Lato font-semibold bg-azul-marino text-white text-md lg:px-40 py-3 block m-auto rounded-xl hover:text-white hover:bg-gris p-3 transition-all mb-10 text-center"
      >Más informacion</a
    >
    <p class="font-Lato font-semibold mt-4 text-lg">
      Un lugar ideal para colaborar y crear
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] my-2">
      Flexible
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] mb-2">
      Comunidad
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] mb-10">
      Wi-Fi
    </p>
  </article>

  <article
    class="border-4 border-gris bg-gris/20 py-7 px-3 my-3 lg:w-1/4 w-3/4 md:w-52"
  >
    <Popular />
    <h3 class="font-Poppins font-semibold text-xl">Espacio privado</h3>
    <p class="font-Poppins font-semibold text-2xl leading-3 my-3">
      $200.000 <br />
      <span class="text-lg">por mes</span>
    </p>
    <a
      href="https://wa.me/573226530630"
      target="_blank"
      rel="noopener"
      class="font-Lato font-semibold bg-azul-marino text-white text-md lg:px-40 py-3 block m-auto rounded-xl hover:text-white hover:bg-gris p-3 transition-all mb-10 text-center"
      >Más informacion</a
    >
    <p class="font-Lato font-semibold mt-4 text-lg">
      Tu propio espacio para trabajar con comodidad
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] my-2">
      Privacidad
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] mb-2">
      Comodidad
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] mb-3">
      Wi-Fi
    </p>
  </article>

  <article
    class="lg:w-1/4 w-3/4 md:w-52 border-2 border-gris bg-gris/20 py-7 px-3 my-3"
  >
    <h3 class="font-Poppins font-semibold text-xl">Oficina privada</h3>
    <p class="font-Poppins font-semibold text-2xl leading-3 my-3">
      $300.000 <br />
      <span class="text-lg">por mes</span>
    </p>
    <a
      href="https://wa.me/573226530630"
      target="_blank"
      rel="noopener"
      class="font-Lato font-semibold bg-azul-marino text-white text-md lg:px-40 py-3 block m-auto rounded-xl hover:text-white hover:bg-gris p-3 transition-all mb-10 text-center"
      >Más informacion</a
    >
    <p class="font-Lato font-semibold mt-4 text-lg">
      Un espacio completamente privado para tu negocio
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] my-2">
      Exclusividad
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] mb-2">
      Privacidad
    </p>
    <p class="font-Lato font-medium text-lg before:content-['✔'] mb-10">
      Wi-Fi
    </p>
  </article>
</div>
