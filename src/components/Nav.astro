<script>
  const $menu = document.getElementById("Open");
  const $close = document.getElementById("Close");
  const $body = document.getElementById("Body");

  $menu.addEventListener("click", () => {
    $body.classList.remove("hidden");
    $body.classList.add("flex");
    $menu.classList.add("hidden");
    $close.classList.remove("hidden");
  });

  $close.addEventListener("click", () => {
    $body.classList.add("hidden");
    $body.classList.remove("flex");
    $menu.classList.remove("hidden");
    $close.classList.add("hidden");
  });
</script>

<nav
  class="lg:flex items-center justify-between bg-azul-marino text-white font-Lato hidden fixed w-screen top-0"
>
  <a href="/"
    ><div class="flex items-center ml-10 p-3 gap-4">
      <img
        src="/favicon.png"
        alt="Consiente Coworking logo"
        class="w-20 rounded-full"
      />
      <h1 class="text-white text-2xl font-Inter">
        Con-siente <br /> CoWorking
      </h1>
    </div></a
  >

  <div class="flex gap-5 mr-20 items-center">
    <a href="#Contact"
      ><button
        class="bg-white text-azul-marino py-2 px-16 rounded-lg text-lg hover:bg-gris hover:text-white transition-colors"
        >Contactar</button
      ></a
    >

    <a href="/" target="_blank" rel="noopener"
      ><i
        class="fa-brands fa-tiktok text-2xl cursor-pointer hover:text-azul-marino hover:bg-white p-3 rounded-3xl transition-all"
      ></i></a
    >
    <a href="/" target="_blank" rel="noopener"
      ><i
        class="fa-brands fa-instagram text-2xl cursor-pointer hover:text-azul-marino hover:bg-white p-3 rounded-3xl transition-all"
      ></i></a
    >
    <a href="/" target="_blank" rel="noopener"
      ><i
        class="fa-brands fa-facebook text-2xl cursor-pointer hover:text-azul-marino hover:bg-white p-3 rounded-3xl transition-all"
      ></i></a
    >
  </div>
</nav>

