---
var today = new Date();
var year = today.getFullYear();
---

<footer class="bg-azul-marino justify-center flex">
  <div class="mx-auto p-4 py-6 lg:py-8 lg:w-full">
    <div class="flex md:justify-between">
      <div class="mb-6 md:mb-0 m-auto">
        <a href="/" class="flex items-center">
          <img src="/favicon.png" class="h-12 me-3" alt="FlowBite Logo" />
          <span
            class="self-center text-2xl font-semibold whitespace-nowrap text-white"
            >Con-Siente <br /> Co-Working</span
          >
        </a>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:gap-6 sm:grid-cols-3"></div>
    </div>
    <hr class="my-6 border-gris sm:mx-auto dark:border-gray-700 lg:my-8" />
    <div class="flex items-center flex-col justify-between lg:justify-center">
      <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400"
        >© {year}
        <a href="/" class="hover:underline">Con-Siente Co-Working</a>. All
        Rights Reserved.
      </span>
      <div class="flex gap-10 mr-20 md:m-0 ml-10">
        <a href="/" target="_blank" rel="noopener"
          ><i
            class="fa-brands fa-tiktok text-3xl cursor-pointer text-white hover:text-azul-marino hover:bg-white p-3 rounded-3xl transition-all"
          ></i></a
        >
        <a href="/" target="_blank" rel="noopener"
          ><i
            class="fa-brands fa-instagram text-3xl cursor-pointer text-white hover:text-azul-marino hover:bg-white p-3 rounded-3xl transition-all"
          ></i></a
        >
        <a href="/" target="_blank" rel="noopener"
          ><i
            class="fa-brands fa-facebook text-3xl cursor-pointer text-white hover:text-azul-marino hover:bg-white p-3 rounded-3xl transition-all"
          ></i></a
        >
      </div>
    </div>
  </div>
</footer>
