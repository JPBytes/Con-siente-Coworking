---
var today = new Date();
var year = today.getFullYear();
---

<footer class="bg-azul-marino">
  <div class="mx-auto w-full max-w-screen-xl p-4 py-6 lg:py-8">
    <div class="md:flex md:justify-between">
      <div class="mb-6 md:mb-0">
        <a href="/" class="flex items-center">
          <img src="/favicon.png" class="h-12 me-3" alt="FlowBite Logo" />
          <span
            class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white"
            >Con-Siente Co-Working</span
          >
        </a>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:gap-6 sm:grid-cols-3"></div>
    </div>
    <hr class="my-6 border-gray-200 sm:mx-auto dark:border-gray-700 lg:my-8" />
    <div class="sm:flex sm:items-center sm:justify-between">
      <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400"
        >© {year}
        <a href="/" class="hover:underline">Con-Siente Co-Working</a>. All
        Rights Reserved.
      </span>
    </div>
  </div>
</footer>
