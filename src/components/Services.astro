---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<script>
  const $body = document.querySelectorAll(".body");
  const $shows = document.querySelectorAll(".fa-chevron-down");
  const $hiddens = document.querySelectorAll(".fa-chevron-up");
  const $accordion = document.querySelectorAll(".accordion");

  for (let i = 0; i < $shows.length; i++) {
    $shows[i].addEventListener("click", () => {
      $body[i].classList.remove("hidden");
      $hiddens[i].classList.remove("hidden");
      $shows[i].classList.add("hidden");
    });

    $hiddens[i].addEventListener("click", () => {
      $body[i].classList.add("hidden");
      $hiddens[i].classList.add("hidden");
      $shows[i].classList.remove("hidden");
    });
  }

  for (let i = 0; i < $accordion.length; i++) {
    $accordion[i].addEventListener("click", () => {
      $body[i].classList.toggle("hidden");
      $hiddens[i].classList.toggle("hidden");
      $shows[i].classList.toggle("hidden");
    });
  }
</script>

<div class="accordion cursor-pointer">
  <div class="header flex items-center justify-between">
    <h4 class="title text-2xl">{title}</h4>
    <i class="fa-solid fa-chevron-up hidden"></i>
    <i class="fa-solid fa-chevron-down"></i>
  </div>
  <div class="body hidden">
    <p class="text-lg text-gris mt-1">{body}</p>
  </div>
</div>
