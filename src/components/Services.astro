---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<script>
  const $accordions = document.querySelectorAll(".accordion");

  function toggleAccordion(index) {
    const $body = $accordions[index].querySelector(".body");
    const $show = $accordions[index].querySelector(".fa-chevron-down");
    const $hidden = $accordions[index].querySelector(".fa-chevron-up");

    $body.classList.toggle("hidden");
    $show.classList.toggle("hidden");
    $hidden.classList.toggle("hidden");
  }

  $accordions.forEach((accordion, index) => {
    accordion.addEventListener("click", () => {
      toggleAccordion(index);
    });

    accordion.addEventListener("touchstart", (event) => {
      event.preventDefault();
      toggleAccordion(index);
    });
  });
</script>

<div class="accordion cursor-pointer">
  <div class="header flex items-center justify-between">
    <h4 class="title text-2xl">{title}</h4>
    <i class="fa-solid fa-chevron-up hidden"></i>
    <i class="fa-solid fa-chevron-down"></i>
  </div>
  <div class="body hidden">
    <p class="text-lg text-gris mt-1">{body}</p>
  </div>
</div>
