---
import Layout from "../layouts/Layout.astro";
import Service from "../components/Service.astro";
import Prices from "../components/Prices.astro";
import Services from "../components/Services.astro";
---

<Layout title="Con-siente CoWorking.">
  <header
    class="md:grid grid-cols-2 my-20 text-left mx-auto lg:w-[100%] xl:w-[60%] items-center p-10 lg:pt-32"
  >
    <div class="font-Poppins">
      <h1 class="text-black font-semibold text-5xl text-balance my-5">
        Descubre tu Espacio Ideal
      </h1>
      <p
        class="text-gris font-semibold text-2xl my-7 text-pretty lg:w-2/3 sm:w-96"
      >
        Un ambiente productivo y creativo te espera. Perfecto para freelancers y
        equipos en Envigado
      </p>
    </div>

    <img
      src="/IMGS/personOnLaptop.jpg"
      alt="a person looking a laptop"
      class="m-auto w-3/4]"
    />
  </header>

  <section class="bg-gradient-to-r from-azul-marino to-gris">
    <div class="text-white text-center lg:p-32 p-24">
      <h2 class="text-5xl text-pretty lg:w-1/4 m-auto">
        Innova y Colabora Hoy
      </h2>
      <p
        class="text-gray-400 text-2xl text-balance lg:w-1/3 md:mx-auto my-10 m-auto lg:text-3xl"
      >
        Transforma tu manera de trabajar con espacios pensados para la
        colaboracion y el confort
      </p>
    </div>
  </section>

  <section class="lg:w-[80%] m-auto w-[100%]">
    <h2 class="my-10 text-3xl font-Lato mx-auto ml-10">Nuestros servicios</h2>
    <div
      class="md:grid xl:grid-cols-3 lg:gap-10 align-middle flex flex-col md:grid-cols-2"
    >
      <Service
        src="/IMGS/privateOffice.jpg"
        alt="Image of private offices"
        title="Oficinas privadas"
      />
      <Service
        src="/IMGS/coworkingSpaces.jpg"
        alt="Image of private offices"
        title="Espacios de CoWorking"
      />
      <Service
        src="/IMGS/eventSpaces.png"
        alt="Image of private offices"
        title="Eventos"
      />
      <Service
        src="/IMGS/cafeteria.jpg"
        alt="Image of private offices"
        title="Servicios de cafe"
      />
      <Service
        src="/IMGS/atentiom.jpg"
        alt="Image of private offices"
        title="Acceso 24/7"
      />
      <Service
        src="/IMGS/cowor.jpg"
        alt="Image of private offices"
        title="Salas de reuniones"
      />
    </div>
  </section>

  <section
    class="m-auto lg:w-[60%] my-24 border-2 border-azul-marino p-10 w-[90%]"
  >
    <img
      src="/IMGS/people/boy.jpg"
      alt="photo of a boy smiling at the camera"
      class="w-28 rounded-full"
    />
    <p class="text-xl mt-4 font-Poppins text-gris">
      Consiente CoWorking es increible. El ambiente es acogedor, el personal es
      amable y atento, y las instalaciones son modernas y cómodas. Gracias por
      proporcionar un espacio de trabajo tan maravilloso, ¡Definitivamente
      recomendado!
    </p>
    <h3 class="font-bold mt-4 text-2xl">Andres</h3>
  </section>

  <section class="mb-24">
    <h2 class="my-10 text-3xl font-Lato mx-auto text-center">
      Tabla de precios
    </h2>
    <Prices />
  </section>

  <section
    class="flex flex-col w-[80%] m-auto gap-10 mb-44"
    id="ServicesContainer"
  >
    <h2 class="my-10 text-3xl font-Lato mx-auto">Preguntas frecuentes</h2>
    <Services
      title="¿Que tipo de espacios ofrecen?"
      body="Ofrecemos areas de trabajo compartidas , salas de reuniones y espacios privados para trabajar de manera eficiente"
    />
    <Services
      title="¿Proporcionan servicios adicionales?"
      body="Si, ofrecemos servicios como la impresion,escaneo,cafe, y acceso a eventos para nuestros usuarios"
    />
    <Services
      title="¿Puedo tener acceso a internet?"
      body="Si, nuestros espacios cuentan con una conexion de alta velocidada internet para garantizar que puedas trabajar de manera eficiente "
    />
    <Services
      title="¿Que ventajas tiene un espacio CoWorking?"
      body="Un espacio CoWorking te brinda oportunidad de trabajar en un ambiente colaborativo , creativo y dinamico. Ideal para potenciar tu productividad y networking"
    />
  </section>

  <section class="mb-20">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15866.735737166257!2d-75.5871935!3d6.1730548!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e46830022c9cba9%3A0x3912ec3cbc535547!2sCon-siente%20Coworking!5e0!3m2!1sen!2scr!4v1711842303209!5m2!1sen!2scr"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-[70vh] w-screen lg:h-[40vw]"></iframe>
  </section>

  <section
    class="md:grid grid-cols-2 md:w-[80%] m-auto items-center justify-center mb-10 flex flex-col-reverse"
  >
    <div id="Contact" class="w-[80%] md:w-[100%]">
      <form action="#">
        <div class="mb-4 flex flex-col justify-center">
          <label for="Name" class="text-xl font-Lato">Nombre</label>
          <input
            class="rounded-xl bg-gray-500 text-white text-xl p-3"
            type="text"
            id="Name"
          />
        </div>

        <div class="mb-4 flex flex-col justify-center">
          <label for="Email" class="text-xl font-Lato">Correo Electronico</label
          >
          <input
            class="rounded-xl bg-gray-500 text-white text-xl p-3"
            type="email"
            id="Email"
          />
        </div>

        <div class="mb-4 flex flex-col justify-center">
          <label for="Message" class="text-xl font-Lato">Mensaje</label>
          <textarea
            class="rounded-xl bg-gray-500 text-white text-xl p-1.5 h-[255px]"
            name="message"
            id="Message"></textarea>
        </div>

        <a href="/"
          ><button
            type="submit"
            class="bg-azul-marino text-white py-3 px-8 rounded-xl"
            >Enviar</button
          ></a
        >
      </form>
    </div>

    <div class="flex flex-col justify-center ml-10 mb-10">
      <h3 class="text-4xl">Ponerse en contacto</h3>
      <p class="text-xl text-gris">
        Envianos un mensaje y nos comunicaremos contigo tan pronto como podamos
      </p>
    </div>
  </section>
</Layout>
